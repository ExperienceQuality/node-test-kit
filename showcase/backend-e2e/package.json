{
  "name": "@xq/showcase-backend-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "npx tsx ./src/app.ts",
    "test": "DATABASE_URL=postgres://test:test@127.0.0.1:5432/backend_e2e vitest run",
    "e2e": "cypress open",
    "e2e:run": "cypress run --browser chromium --spec 'cypress/e2e/api/**/*.cy.ts'"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-test-kit": "0.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.15.5",
    "cy-platform": "0.1.0",
    "cypress": "^16.1.0",
    "vitest": "^4.0.0"
  }
}
