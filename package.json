{
  "name": "node-test-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A platform-owned Vitest foundation for backend functional E2E tests.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./vitest": {
      "types": "./dist/src/vitest/test.d.ts",
      "import": "./dist/src/vitest/test.js"
    },
    "./vitest/config": {
      "types": "./dist/src/vitest/config.d.ts",
      "import": "./dist/src/vitest/config.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "demo": "vitest run --config demo/vitest.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "pactum": "^3.9.1"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
