{
  "name": "node-test-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A platform-owned Vitest foundation for backend functional E2E tests.",
  "workspaces": [
    "packages/*",
    "showcase/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "npm run verify:structure && npm run build && npm run check --workspaces --if-present",
    "test": "npm run test --workspace @xq/node-test-kit-rest-client --workspace @xq/node-test-kit-db --workspace @xq/node-test-kit-stub --workspace @xq/node-test-kit-core --workspace node-test-kit",
    "showcase": "npm run test --workspace @xq/showcase-backend-e2e",
    "pack": "npm run verify:packages",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
