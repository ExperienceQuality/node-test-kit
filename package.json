{
  "name": "xq-test-platform",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "A platform-owned Vitest foundation for backend functional E2E tests.",
  "workspaces": [
    "packages/*",
    "showcase/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "npm run verify:structure && npm run lint && npm run format:check && npm run build && npm run check --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write eslint.config.js .prettierrc.json package.json scripts/verify-packages.mjs .github/workflows/build.yml",
    "format:check": "prettier --check eslint.config.js .prettierrc.json package.json scripts/verify-packages.mjs .github/workflows/build.yml",
    "test": "npm run test --workspace @experiencequality/rest-client --workspace @experiencequality/db --workspace @experiencequality/stub --workspace @experiencequality/core --workspace @experiencequality/test",
    "test:e2e": "npm run test --workspace @experiencequality/showcase-backend-e2e",
    "showcase": "npm run test --workspace @experiencequality/showcase-backend-e2e",
    "showcase:app": "npm run start --workspace @experiencequality/showcase-backend-e2e",
    "pack": "npm run verify:packages",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "ci:build": "npm run verify:structure && npm run verify:packages",
    "ci:cucumber": "npm run build && node scripts/verify-cucumber-report.mjs",
    "ci:test": "node scripts/ci-test.mjs",
    "ci:release": "node scripts/ci-test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.0"
  }
}
