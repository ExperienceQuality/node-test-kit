{
  "name": "@xq/test-cypress",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Platform-owned Cypress plugins and commands.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "cypress": "^16.1.0"
  },
  "dependencies": {
    "cypress-plugin-api": "^2.12.3"
  },
  "devDependencies": {
    "cypress": "^16.1.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
